# Токен бота от @BotFather. Без него бот не стартует.
TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Telegram id владельца (команда !id в личке бота). Полный доступ,
# включая !админку и теневую !модерацию. Менять — перезапустить бота.
OWNER_ID=123456789

# --- Транскрибация голосовых в !цитата (необязательно, есть дефолты) ---
# Модель whisper: tiny (быстро, хуже русский) или base (точнее).
WHISPER_MODEL=base
# Максимум секунд голосового/кружка в цитату.
VOICE_QUOTE_MAX_SEC=180
# 1 — включить расшифровку, 0 — отвечать заглушкой.
VOICE_QUOTE_ENABLED=0
# Подсказка со словарём чата (сокращения, сленг). До ~200 символов.
# WHISPER_PROMPT=Разговорная русская речь, студенческий чат.
